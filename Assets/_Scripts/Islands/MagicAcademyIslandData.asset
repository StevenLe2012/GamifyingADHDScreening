  icon: {fileID: 21300000, guid: b4a7e9c9e2f6d424fbac6d8e335a232e, type: 3}
  introTitle: Welcome to Magic Academy!
  introBody: "This training will prepare you for the adventure ahead.\n\nYour task
    is simple: press SPACE as quickly and accurately as possible to collect only
    the books marked with THREE FLOWERS and recover the lost knowledge of this mysterious
    world.\n\nBeware - every other book is a trick. Ignore them and keep your focus
    on the red plus sign.\n\nWhen you\u2019re ready, press SPACE to begin your training."
  countdownSeconds: 5
  hasMoxoGame: 1
  startsDialogueOnArrival: 1
  dialogueHandlerType: DragonHandler
  trainingIntroTitle: 
  trainingIntroBody: 
  readyIntroTitle: Focus
  readyIntroBody: 'Random visual and audio distractions will appear -  ignore them
    and keep your focus on the red plus sign.


    Are you ready? Use the arrow
    keys to choose:


    * Start - Begin the mission

    * Training - Practice
    again


    Press SPACE to confirm. Good luck!'
