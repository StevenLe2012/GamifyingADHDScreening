  islandId: BREAD
  displayName: Bread Island
  icon: {fileID: 21300000, guid: cdc9ddcff9f34264a8952145891c8454, type: 3}
  introTitle: Welcome to Sweet Factory!
  introBody: "Your mission is to press SPACE as quickly as possible to collect only
    the card with THREE DONUTS. \r\n\r\nAll other cards are sugar traps - leave them
    alone and keep your focus on the red cross.\r\n\r\nWhen you\u2019re ready, press
    SPACE to begin a training round."
  countdownSeconds: 5
  hasMoxoGame: 1
  startsDialogueOnArrival: 1
  dialogueHandlerType: DragonHandler
  trainingIntroTitle: Welcome to Sweet Factory!
  trainingIntroBody: "I\u2019m Donutella, the chef behind every delicious creation
    on this island. I\u2019ll reward you with the gem, but only if you help me prepare
    the perfect dessert for the people.\r\n\r\nPress SPACE as quickly as possible
    to collect only the correct recipe with THREE DONUTS.\r\n\r\nBe careful - every
    other option is a sugar trap. Leave them alone and keep your focus on the red
    plus sign.\r\n\r\nWhen you\u2019re ready, press SPACE to begin a training round.\r"
  readyIntroTitle: Focus
  readyIntroBody: 'Random visual and audio distractions will appear -  ignore them
    and keep your focus on the red plus sign.


    Are you ready? Use the arrow
    keys to choose:

    * Start - Begin the mission

    * Training - Practice again


    Press
    SPACE to confirm. Good luck!'
