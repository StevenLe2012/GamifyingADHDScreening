  islandId: CARDS
  displayName: 
  icon: {fileID: 21300000, guid: 3bb9a0ad94dbc63488558423d275065d, type: 3}
  introTitle: Welcome to Cards Kingdom!
  introBody: "I am Rosaria, Guardian of this island. I will grant you the gem but
    only if you prove your worth.\n\r\nYour task is simple: press SPACE as quickly
    and accurately as possible to collect only the cards with THREE HEARTS and help
    rebuild the broken kingdom.\n\r\nBeware - every other card is a trap. Ignore
    them, and keep your focus on the red plus sign.\r"
  countdownSeconds: 5
  hasMoxoGame: 1
  startsDialogueOnArrival: 1
  dialogueHandlerType: DragonHandler
  trainingIntroTitle: Welcome to Cards Kingdom!
  trainingIntroBody: "I am Joker of this island. I will grant you the gem but only
    if you prove your worth. \n\r\nYour task is simple: press SPACE as quickly and
    accurately as possible to collect only the cards with THREE HEARTS and help rebuild
    the broken kingdom. \n\r\nBeware - every other card is a fool in disguise. Ignore
    them, and keep your focus on the red plus sign.\n\nWhen you\u2019re ready, press
    SPACE to begin a training round.\r\n"
  readyIntroTitle: Focus
  readyIntroBody: 'Random visual and audio distractions will appear -  ignore them
    and keep your focus on the red plus sign.


    Are you ready? Use the arrow
    keys to choose:


    * Start - Begin the mission

    * Training - Practice
    again


    Press SPACE to confirm. Good luck!'
