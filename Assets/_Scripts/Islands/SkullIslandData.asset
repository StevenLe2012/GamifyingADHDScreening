  displayName: 
  icon: {fileID: 21300000, guid: 88683e0d2618a8f4ab5f3a59621cf219, type: 3}
  introTitle: Welcome to Skull Island!
  introBody: "Your mission is to press SPACE as quickly and accurately as possible
    to collect only the RED skull.\r\n\r\nAll other skulls are cursed impostors -
    leave them alone and keep your focus on the red plus sign.\r\n\r\nWhen you\u2019re
    ready, press SPACE to begin a training round."
  countdownSeconds: 5
  hasMoxoGame: 1
  startsDialogueOnArrival: 1
  dialogueHandlerType: DragonHandler
  trainingIntroTitle: Welcome to Skull Island!
  trainingIntroBody: "I am the ghost of Falkor - the ancient captain who once discovered
    every island in the world. I will unlock the gem for you, but only if you prove
    your skill.\r\n\r\nPress SPACE as quickly as possible to collect only the correct
    flags marked with THREE SKULLS to guide the ships safely through the storm.\r\n\r\nBe
    careful - other flags will lead them astray. Leave them alone and keep your focus
    on the red plus sign.\r\n\r\nWhen you\u2019re ready, press SPACE to begin a training
    round.\r"
  readyIntroTitle: Focus
  readyIntroBody: 'Random visual and audio distractions will appear -  ignore them
    and keep your focus on the red plus sign.


    Are you ready? Use the arrow
    keys to choose:

    * Start - Begin the mission

    * Training - Practice again


    Press
    SPACE to confirm. Good luck!'
  nonMoxoIntroVoice: {fileID: 0}
